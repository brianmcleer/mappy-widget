{
  "name": "City GIS",
  "instructions": "Read-only tools over the city GIS: addresses, what is at a place, the closest feature, features within a distance, searching and summarizing layers, and finding maps.",
  "allowed_origins": [
    "https://gis.example.org",
    "https://maps.example.org",
    "http://localhost:3001",
    "https://localhost:3001"
  ],
  "portal_url": "https://portal.example.org/portal",
  "locator_url": "https://gis.example.org/arcgis/rest/services/Locators/AddressLocator/GeocodeServer",
  "locator_single_line_field": "SingleLine",
  "service_folders": [
    "https://gis.example.org/arcgis/rest/services/REPLACE_WITH_FOLDER"
  ],
  "layers": [
    {
      "name": "Parcels",
      "url": "https://gis.example.org/arcgis/rest/services/REPLACE/MapServer/0",
      "search_fields": [
        "SITUS",
        "OWNER",
        "PARCEL_NUM"
      ]
    }
  ],
  "require_token": false,
  "max_results": 25,
  "timeout_seconds": 20,
  "identify_max_layers": 15,
  "identify_point_tolerance_feet": 25,
  "nearest_max_feet": 26400,
  "refresh_minutes": 60,
  "verify_tls": true,
  "log_dir": "logs",
  "log_days": 30,
  "upstream_servers": [
    {
      "name": "esri",
      "label": "ArcGIS Location Services",
      "url": "https://location-services-mcp.arcgis.com/beta/mcp",
      "auth": "api_key",
      "api_key_env": "ESRI_LOCATION_API_KEY",
      "prefix": "esri_",
      "enabled": false
    },
    {
      "name": "enterprise",
      "label": "ArcGIS Enterprise",
      "url": "https://portal.example.org/portal/REPLACE_WHEN_ESRI_SHIPS_IT/mcp",
      "auth": "user_token",
      "prefix": "portal_",
      "enabled": false
    }
  ],
  "public_url": "https://gis.example.org/gis-mcp",
  "oauth_authorization_servers": [],
  "assistant": {
    "enabled": false,
    "label": "Claude",
    "api_key_env": "ANTHROPIC_API_KEY",
    "model": "claude-sonnet-5-5",
    "max_tokens": 1200,
    "max_steps": 6,
    "timeout_seconds": 60,
    "require_token": true,
    "identify": true,
    "usage_names": false,
    "per_person_per_hour": 30,
    "per_person_per_day": 50,
    "per_person_per_month": 500,
    "per_person_tokens_per_month": 0,
    "groups": [],
    "allow_groups": [],
    "warn_at": 5,
    "per_day": 1000,
    "per_month": 0,
    "max_tokens_per_month": 0,
    "org_name": "the City",
    "extra_instructions": "",
    "cache_minutes": 10,
    "max_tokens_per_day": 0,
    "redact_fields": [],
    "log_questions": false,
    "anonymous_per_hour": 5,
    "allow_images": true,
    "price_per_mtok_in": 0,
    "price_per_mtok_out": 0,
    "price_per_mtok_cached": 0,
    "total_seconds": 95,
    "ca_bundle": "",
    "apps_only": true,
    "feedback": true
  }
}
