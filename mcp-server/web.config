<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for gis-mcp (in-house MCP server for Mappy and other AI tools).
  Same pattern as the Droplets relay: IIS starts the Python process below through the
  HttpPlatformHandler module, hands it a port in HTTP_PLATFORM_PORT, and proxies requests
  to it. Nothing else listens on the network. Edit the D:\ paths if the folder is elsewhere.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="D:\GIS\Services\gis-mcp\.venv\Scripts\python.exe"
                  arguments="D:\GIS\Services\gis-mcp\gis_mcp.py --config D:\GIS\Services\gis-mcp\config.json"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:02:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="D:\GIS\Services\gis-mcp\logs\stdout">
      <environmentVariables>
        <environmentVariable name="GIS_MCP_BASE_PATH" value="/gis-mcp" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="262144" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
